# Copiar a ~/apps/GrammarErrorDetection/api/.env en el VPS (chmod 600) y rellenar. NUNCA subirlo a git.
# Lo que NO es secreto y cambia entre desarrollo y produccion (URLs, rutas del servidor de archivos,
# LoginUrl, NLP) vive en GrammarErrorDetection.API/appsettings.Production.json.
# Cualquier variable de este archivo gana sobre appsettings.Production.json.

# --- JWT ---
# Genera uno propio y distinto al de desarrollo:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=grammar-api
JWT_AUDIENCE=grammar-frontend
JWT_EXPIRATION_MINUTES=60
VERIFICATION_CODE_EXPIRATION_MINUTES=10

# --- PostgreSQL (contenedor "postgres" del repo BD, misma red app-net) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=grammarerrordetection_bd
DB_USER=grammar_api
# Igual a DB_API_PASSWORD del .env de ~/apps/GrammarErrorDetection/bd
DB_PASSWORD=

# --- Correo (verificacion en dos pasos, altas) ---
GMAIL_EMAIL=
GMAIL_APPPASSWORD=

# --- Opcionales (ya tienen valor en appsettings.Production.json) ---
# NLP_API_URL=http://ml-api:8000/api/analyze
# Verificacion de vocabulario (API gratuita Datamuse, seccion "Vocabulary" de appsettings.Production.json).
# Hoy no necesita clave (hasta 100 000 peticiones/dia). Desde 2027-02-01 Datamuse exigira una: ver README.
# NO definas FILES_API_KEY en el repo BD: AchievementFileService no envia X-Api-Key y los
# enlaces publicos /files/... se abren desde el navegador sin cabecera.
